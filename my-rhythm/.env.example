# ─── Supabase (Project Settings → API) ───────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server only. NEVER expose this in client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Single-user lock ────────────────────────────────────────────────
# Comma-separated list of emails allowed to use the app (just you).
ALLOWED_EMAILS=you@example.com

# ─── App URL (used in notifications + cron) ─────────────────────────
NEXT_PUBLIC_APP_URL=https://my-rhythm.vercel.app

# ─── Web Push (generate with: npm run vapid) ─────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ─── Scheduler: shared secret for /api/cron/tick ─────────────────────
# Any long random string (e.g. `openssl rand -hex 32`).
CRON_SECRET=

# ─── AI (Anthropic Claude API, server-side only) ─────────────────────
ANTHROPIC_API_KEY=
# Optional override. Default: claude-opus-5-5
ANTHROPIC_MODEL=

# Secret used to sign notification receipts/actions (any long random string)
PUSH_ACTION_SECRET=
