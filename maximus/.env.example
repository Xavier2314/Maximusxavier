# -----------------------------------------------------------------------------
# Maximus environment variables
# Copy to .env.local for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables.
# Variables starting with NEXT_PUBLIC_ are sent to the browser. Everything
# else is server-only and must never be exposed.
# -----------------------------------------------------------------------------

# --- Supabase (required) — Supabase dashboard → Project Settings → API ---------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Used by background jobs (reminders, push delivery). Never commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App URL (required) -------------------------------------------------------
# Used in password-reset and email-confirmation links.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# --- Web push (optional until push is switched on) ----------------------------
# Generate once with:  npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Background jobs (required in production) ---------------------------------
# Any long random string. Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=

# --- Maximus AI (optional until the assistant is switched on) -----------------
# Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional override of the model used by Maximus AI.
MAXIMUS_AI_MODEL=

# --- AI prospect follow-up: WhatsApp (optional) --------------------------------
# Meta WhatsApp Cloud API: one WhatsApp Business number for the organisation.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any random string; paste the same value into Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
# Meta app secret, used to check that webhook calls really come from Meta.
WHATSAPP_APP_SECRET=
# Approved template for the first message ({{1}} = prospect's first name, {{2}} = member's first name).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# --- AI prospect follow-up: Gmail (optional) ------------------------------------
# Google Cloud OAuth client (Web application). Redirect URI:
#   https://YOUR-DOMAIN/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Spotify search (optional; pasting Spotify links works without it) -----------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
