# Copy to .env.local for local development. On Vercel, set these in Project Settings > Environment Variables.
# Never commit real values.

# Public site URL (used for payment callbacks, sitemap and social previews)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Supabase (Project Settings > API). The service role key is server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Paystack (Dashboard > Settings > API Keys & Webhooks). Use test keys until launch.
PAYSTACK_SECRET_KEY=

# Admin dashboard
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=   # long random string, 32+ characters

# Optional: confirmation emails via Resend
RESEND_API_KEY=
EMAIL_FROM="Accelerator Community <events@your-domain.com>"

# Optional: record part-payment commitment letters in a Google Sheet (see docs/part-payment-sheet.md)
PART_PAYMENT_SHEET_URL=      # Google Apps Script web-app URL
PART_PAYMENT_SHEET_SECRET=   # same random string as SECRET in the script
